{
  "name": "monaco-ai-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node server.mjs\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node server.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fast-diff": "^1.3.0",
    "monaco-editor": "^0.55.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/acorn": "^6.0.4",
    "@types/fast-diff": "^1.2.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "fast-check": "^4.5.3",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.17",
    "vue-tsc": "^3.1.4"
  }
}
